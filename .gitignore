# Secrets: never commit real environment files
.env
.env.*
!.env.example
*.pem
*credentials*.json
*token*.json

# Database dumps and exports (contain customer personal data and password hashes)
*.bson
*export*/
*backup*/
*.dump

# Dependencies and builds
node_modules/
frontend/build/
dist/
coverage/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Archives
*.zip
*.tar
*.tar.gz
*.tgz

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
