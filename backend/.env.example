# Copy to backend/.env for local development. Never commit the real .env.

ENVIRONMENT=development

MONGO_URL=mongodb://localhost:27017
DB_NAME=oxys_barbershop_dev

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720

CORS_ORIGINS=http://localhost:3000

# Leave empty locally. On Fly.io this is set to Fly-Client-IP in fly.toml.
CLIENT_IP_HEADER=

# Booking confirmation e-mails (optional; skipped when empty). For Gmail use an app password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

# Google reviews widget (optional)
GOOGLE_API_KEY=
GOOGLE_PLACE_ID=
